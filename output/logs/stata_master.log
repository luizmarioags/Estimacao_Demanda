. 
. forvalues i = 1/10 {
  2.     local zlist "${Z`i'}"
  3.     di as text "Estimando modelo Z`i': `zlist'"
  4. 
.     quietly ivreg2 qc y pb (pf = `zlist'), robust first
  5. 
.     scalar b = _b[pf]
  6.     scalar se = _se[pf]
  7.     scalar ci_l = b - invnormal(0.975)*se
  8.     scalar ci_h = b + invnormal(0.975)*se
  9.     scalar nobs = e(N)
 10. 
.     * weakivtest é a rotina principal de instrumentos fracos.
.     quietly weakivtest
 11. 
.     capture scalar feff = r(F_eff)
 12.     if _rc scalar feff = .
 13. 
.     capture scalar c5 = r(c_TSLS_5)
 14.     if _rc scalar c5 = .
 15. 
.     capture scalar c10 = r(c_TSLS_10)
 16.     if _rc scalar c10 = .
 17. 
.     post H ("Z`i'") ("`zlist'") (b) (se) (ci_l) (ci_h) (feff) (c5) (c10) (nobs)
 18. }
